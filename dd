const initials=grp.name.replace(/[^\w\s]/g,'').trim().split(' ').map(w=>w[0]).join('').slice(0,2).toUpperCase()||'GP';
userSection.innerHTML=`<div class="conv-opt-grp-av">${initials}</div><div class="conv-opt-name">${grp.name}</div><div class="conv-opt-sub">${grp.memberIds.length+1} members</div>`;
menu.innerHTML=`
<div class="conv-opt-item" onclick="closeConvOpt();openGroupInfo('${grp.id}')"><div class="conv-opt-icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg></div>Group info</div>
<div class="conv-opt-item" onclick="pinGroupItem('${grp.id}')"><div class="conv-opt-icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg></div>${grp.pinned?'Unpin':'Pin'} group</div>
<div class="conv-opt-item" onclick="closeConvOpt()"><div class="conv-opt-icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg></div>Mute notifications</div>
<div class="conv-opt-item" onclick="clearGrpMsgs('${grp.id}')"><div class="conv-opt-icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg></div>Clear chat</div>
<div class="conv-opt-item danger" onclick="closeConvOpt()"><div class="conv-opt-icon" style="background:rgba(239,68,68,.1)"><svg width="18" height="18" fill="none" stroke="#F87171" stroke-width="2.2" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></div>Leave group</div>`;
} else {
const conv=CONVS.find(c=>c.uid===uid); const usr=u(uid); if(!usr) return;
const dname=conv?.nickname||usr.name;
userSection.innerHTML=`<img class="conv-opt-av" src="${usr.av}" alt="" onclick="closeConvOpt();openUserProfile(${uid})"><div class="conv-opt-name">${dname}</div><div class="conv-opt-sub">${usr.handle} · ${usr.online?'Online':'Offline'}</div>`;
menu.innerHTML=`
<div class="conv-opt-item" onclick="closeConvOpt();openUserProfile(${uid})"><div class="conv-opt-icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div>View profile</div>
<div class="conv-opt-item" onclick="pinConvItem(${uid})"><div class="conv-opt-icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg></div>${conv?.pinned?'Unpin':'Pin'} conversation</div>
<div class="conv-opt-item" onclick="openMuteFor(${uid})"><div class="conv-opt-icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg></div>Mute notifications</div>
<div class="conv-opt-item" onclick="openNickDialog(${uid})"><div class="conv-opt-icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></div>Edit nickname</div>
