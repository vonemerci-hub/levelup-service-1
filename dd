}
document.getElementById('conv-opt-overlay').classList.add('open');
}
function closeConvOpt(){ document.getElementById('conv-opt-overlay').classList.remove('open'); }
function pinConvItem(uid){ const c=CONVS.find(x=>x.uid===uid); if(c){ c.pinned=!c.pinned; closeConvOpt(); renderConvs(); } }
function pinGroupItem(gid){ const g=GROUPS.find(x=>x.id===gid); if(g){ g.pinned=!g.pinned; closeConvOpt(); renderGroups(); } }
function clearDmMsgs(uid){ const c=CONVS.find(x=>x.uid===uid); if(c){ c.msgs=[]; closeConvOpt(); } }
function clearGrpMsgs(gid){ const g=GROUPS.find(x=>x.id===gid); if(g){ g.msgs=[]; closeConvOpt(); } }
function blockUser(uid){ const usr=u(uid); closeConvOpt(); }
function openMuteFor(uid){ convOptTargetUID=uid; closeConvOpt(); setTimeout(()=>document.getElementById('mute-overlay').classList.add('open'),200); }
function muteFor(dur){ const labels={h8:'8 hours','1w':'1 week',always:'Always'}; const c=CONVS.find(x=>x.uid===convOptTargetUID); if(c) c.muted=true; document.getElementById('mute-overlay').classList.remove('open'); const usr=u(convOptTargetUID); renderConvs(); }

/* NICKNAME */
function openNickDialog(uid){
convOptTargetUID=uid; closeConvOpt();
const usr=u(uid); const conv=CONVS.find(c=>c.uid===uid);
document.getElementById('nick-sub').textContent='Only visible to you for '+usr?.name;
document.getElementById('nick-inp').value=conv?.nickname||'';
setTimeout(()=>{ document.getElementById('nick-overlay').classList.add('open'); setTimeout(()=>document.getElementById('nick-inp').focus(),100); },200);
}
function closeNickDialog(){ document.getElementById('nick-overlay').classList.remove('open'); }
function confirmNickname(){
const val=document.getElementById('nick-inp').value.trim();
const conv=CONVS.find(c=>c.uid===convOptTargetUID);
if(conv){ conv.nickname=val||null; }
closeNickDialog(); renderConvs();
if(val&&chatUID===convOptTargetUID){ document.getElementById('chat-name-h').textContent=val; }
}

/* ═══════════════════════════════════════
PROFILE
═══════════════════════════════════════ */
function renderProfile(){
document.getElementById('my-username').textContent=ME.handle;
document.getElementById('my-prof-av').src=ME.av;
const c=POSTS.filter(p=>p.uid==='me').length;
document.getElementById('my-posts-count').textContent=c;
renderProfGrid();
}
function renderProfGrid(){
document.getElementById('prof-grid').innerHTML=PROFILE_IMGS.map((img,i)=>`
<div class="prof-cell">
<img src="${img}" alt="" loading="lazy">
${i%4===1?'<div class="reel-icon"><svg width="14" height="14" fill="white" viewBox="0 0 24 24"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg></div>':''}
</div>`).join('');
}
function switchProfTab(i,el){
document.querySelectorAll('.prof-tab').forEach(t=>t.classList.remove('active')); el.classList.add('active');
const grid=document.getElementById('prof-grid');
if(i===0) renderProfGrid();
else if(i===1) grid.innerHTML=[0,2,5,7].map(j=>`<div class="prof-cell"><img src="${PROFILE_IMGS[j]}" alt="" loading="lazy"><div class="reel-icon"><svg width="14" height="14" fill="white" viewBox="0 0 24 24"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg></div></div>`).join('');
else grid.innerHTML=[1,4,6,8].map(j=>`<div class="prof-cell"><img src="${PROFILE_IMGS[j]}" alt="" loading="lazy"></div>`).join('');
}

