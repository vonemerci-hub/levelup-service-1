<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no,interactive-widget=resizes-content">
<title>OPPA — Connect & Share</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
:root{
--bg:#08080D;--bg2:#0D0D1A;
--surface:rgba(255,255,255,.04);--surface2:rgba(255,255,255,.08);--surface3:rgba(255,255,255,.12);
--border:rgba(255,255,255,.07);--border2:rgba(255,255,255,.12);
--accent:#7C3AED;--accent2:#9F67FA;--accent-light:#C4B5FD;--accent-glow:rgba(124,58,237,.3);
--text:#F0EEFF;--text2:#8B8BA7;--text3:#3D3D55;
--green:#34D399;--red:#F87171;--pink:#EC4899;--gold:#F59E0B;
--nav-h:68px;
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;user-select:none}
html,body{height:100%;width:100%;background:#000;font-family:'Outfit',sans-serif;color:var(--text);overflow:hidden;position:fixed;overscroll-behavior:none}
input,textarea{user-select:text}
#app{width:100%;height:100dvh;background:var(--bg);position:relative;overflow:hidden}

/* SCREENS */
.screen{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;background:var(--bg);opacity:0;pointer-events:none;transition:opacity .25s ease,transform .25s ease;transform:translateY(8px)}
.screen>*{width:100%;max-width:600px}
.screen.active{opacity:1;pointer-events:all;transform:translateY(0)}
.scroll-area{flex:1;overflow-y:auto;overflow-x:hidden;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding-bottom:var(--nav-h)}
.scroll-area::-webkit-scrollbar{display:none}

/* NAV */
#bottom-nav{position:absolute;bottom:0;left:0;right:0;z-index:200;height:var(--nav-h);background:rgba(8,8,13,.92);backdrop-filter:blur(32px);border-top:1px solid var(--border);display:none;align-items:center;justify-content:space-around;padding:0 4px env(safe-area-inset-bottom)}
.nav-item{display:flex;flex-direction:column;align-items:center;gap:4px;padding:8px 14px;cursor:pointer;transition:all .2s;position:relative;flex:1}
.nav-item svg{opacity:.4;transition:all .25s}
.nav-item.active svg{opacity:1;filter:drop-shadow(0 0 8px var(--accent2))}
.nav-label{font-size:10px;font-weight:600;color:var(--text2);opacity:.4;transition:all .25s;letter-spacing:.3px}
.nav-item.active .nav-label{color:var(--accent-light);opacity:1}
.nav-badge{position:absolute;top:5px;right:8px;width:17px;height:17px;background:#EF4444;border-radius:50%;font-size:10px;font-weight:800;color:#fff;display:flex;align-items:center;justify-content:center;border:2px solid var(--bg)}
.nav-post{width:50px;height:50px;background:linear-gradient(135deg,var(--accent),var(--accent2));border-radius:18px;display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;box-shadow:0 6px 24px var(--accent-glow);transition:all .2s}
.nav-post:active{transform:scale(.9)}

/* BUTTONS */
.btn-primary{background:linear-gradient(135deg,var(--accent),var(--accent2));border:none;border-radius:14px;padding:15px;color:#fff;font-family:'Outfit',sans-serif;font-size:16px;font-weight:700;cursor:pointer;transition:all .2s;letter-spacing:.3px;box-shadow:0 6px 24px var(--accent-glow);width:100%}
.btn-primary:active{transform:scale(.97)}
.btn-ghost{display:flex;align-items:center;justify-content:center;gap:10px;background:rgba(255,255,255,.06);border:1px solid var(--border2);border-radius:14px;padding:14px;color:var(--text);font-family:'Outfit',sans-serif;font-size:14px;font-weight:600;cursor:pointer;transition:all .2s;width:100%}
.btn-ghost:active{transform:scale(.97)}
.icon-btn{width:38px;height:38px;background:var(--surface2);border-radius:13px;display:flex;align-items:center;justify-content:center;cursor:pointer;position:relative;transition:all .15s;border:1px solid var(--border);flex-shrink:0}
.icon-btn:active{transform:scale(.88)}
.back-btn{width:38px;height:38px;display:flex;align-items:center;justify-content:center;cursor:pointer;border-radius:12px;transition:background .15s;flex-shrink:0}
.back-btn:active{background:var(--surface2)}
.divider{display:flex;align-items:center;gap:12px}
.divider::before,.divider::after{content:'';flex:1;height:1px;background:var(--border)}
.divider span{color:var(--text3);font-size:12px;font-weight:600}
.inp{background:var(--surface2);border:1.5px solid var(--border);border-radius:14px;padding:14px 16px;color:var(--text);font-family:'Outfit',sans-serif;font-size:15px;outline:none;transition:border-color .2s,box-shadow .2s;width:100%}
.inp:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-glow)}
.inp::placeholder{color:var(--text3)}

/* AUTH */
#screen-auth{justify-content:center;align-items:center;padding:0}
#screen-auth>*{max-width:100%}
.auth-hero{width:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:60px 20px 20px;background:radial-gradient(ellipse 120% 80% at 50% 0%,rgba(124,58,237,.25) 0%,transparent 60%)}
.auth-logo-text{font-size:80px;font-weight:900;letter-spacing:-5px;line-height:1;background:linear-gradient(135deg,#fff 0%,#C4B5FD 40%,#7C3AED 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;text-align:center}
.auth-tagline{color:var(--text2);font-size:13px;font-weight:500;margin-top:10px;letter-spacing:1.5px;text-transform:uppercase;text-align:center}
.auth-form-container{width:100%;max-width:440px;padding:20px 28px max(50px,env(safe-area-inset-bottom));margin:0 auto;display:flex;flex-direction:column;flex:1;justify-content:center}
.auth-card{background:rgba(13,13,26,.8);border:1px solid var(--border2);border-radius:28px;padding:32px 26px;backdrop-filter:blur(40px);box-shadow:0 20px 40px rgba(0,0,0,.3)}
.auth-form{display:flex;flex-direction:column;gap:14px}
.key-toggle-btn{width:100%;display:flex;align-items:center;justify-content:center;gap:10px;background:rgba(255,255,255,.06);border:1.5px solid var(--border2);border-radius:14px;padding:15px;color:var(--text2);font-family:'Outfit',sans-serif;font-size:14px;font-weight:600;cursor:pointer;transition:all .2s}
.key-toggle-btn:active{transform:scale(.97)}
.key-field-wrap{display:none;flex-direction:column;gap:10px}
.key-field-wrap.visible{display:flex}

/* HEADER */
.app-header{padding:max(18px,env(safe-area-inset-top)) 18px 10px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
.app-logo{font-size:28px;font-weight:900;letter-spacing:-1.5px;background:linear-gradient(135deg,#fff 0%,#A78BFA 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.header-actions{display:flex;gap:10px;align-items:center}

/* STORIES */
.stories-wrap{padding:4px 0 14px;flex-shrink:0}
.stories-scroll{display:flex;gap:12px;padding:4px 18px;overflow-x:auto;scrollbar-width:none}
.stories-scroll::-webkit-scrollbar{display:none}
.story-item{display:flex;flex-direction:column;align-items:center;gap:6px;cursor:pointer;flex-shrink:0}
.story-ring{width:66px;height:66px;border-radius:22px;padding:2.5px;background:linear-gradient(135deg,#7C3AED,#EC4899,#F59E0B);transition:transform .18s;flex-shrink:0}
.story-ring.seen{background:var(--surface3)}
.story-ring:active{transform:scale(.91)}
.story-inner{width:100%;height:100%;border-radius:19.5px;overflow:hidden;border:2.5px solid var(--bg)}
.story-inner img{width:100%;height:100%;object-fit:cover}
.story-name{font-size:11px;color:var(--text2);font-weight:500;max-width:66px;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.story-add-btn{width:66px;height:66px;border-radius:22px;background:var(--surface);border:1.5px dashed var(--border2);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .2s;flex-shrink:0;position:relative}
.story-add-btn:active{transform:scale(.91)}
.limit-dot{position:absolute;top:-3px;right:-3px;background:var(--gold);width:13px;height:13px;border-radius:50%;border:2px solid var(--bg);font-size:8px;color:#000;display:flex;align-items:center;justify-content:center;font-weight:800}

/* POSTS */
.post{margin-bottom:2px;border-bottom:1px solid var(--border);padding-bottom:14px}
.post-header{display:flex;align-items:center;padding:12px 16px 10px;gap:10px}
.post-av{width:42px;height:42px;border-radius:15px;object-fit:cover;border:1.5px solid var(--border2);cursor:pointer;flex-shrink:0}
.post-meta{flex:1;min-width:0}
.post-user{font-size:14px;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:6px}
.post-time{font-size:12px;color:var(--text2)}
.post-more{width:32px;height:32px;display:flex;align-items:center;justify-content:center;cursor:pointer;border-radius:10px;transition:background .15s;flex-shrink:0}
.post-more:active{background:var(--surface2)}
.post-img{width:100%;display:block;cursor:pointer;position:relative}
.post-img img{width:100%;display:block;object-fit:cover}
.post-img-sq img{aspect-ratio:1}
.post-img-land img{aspect-ratio:4/3}
.post-text{padding:12px 16px 8px;font-size:16px;line-height:1.55;color:var(--text)}
.post-actions{display:flex;align-items:center;gap:4px;padding:10px 12px 0}
.post-act{display:flex;align-items:center;gap:6px;cursor:pointer;padding:8px 10px;border-radius:12px;transition:all .15s;color:var(--text2);font-size:14px;font-weight:600}
.post-act:active{background:var(--surface2)}
.post-act.liked{color:var(--red)}
.post-act .cnt{font-size:13px;font-weight:700}
.post-caption{padding:6px 16px 0;font-size:14px;line-height:1.4}
.post-caption b{font-weight:700;margin-right:6px;cursor:pointer}
.type-badge{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:20px;font-size:10px;font-weight:700}
.type-badge.moment{background:rgba(236,72,153,.15);color:var(--pink)}
@keyframes heartPop{0%{transform:scale(1)}30%{transform:scale(1.5)}60%{transform:scale(.92)}100%{transform:scale(1)}}
.heart-pop{animation:heartPop .32s ease}

/* STORY VIEWER */
.story-viewer{position:absolute;inset:0;background:#000;z-index:800;display:none;flex-direction:column;align-items:center}
.story-viewer.open{display:flex}
.sv-progress{display:flex;gap:4px;padding:max(52px,env(safe-area-inset-top)) 14px 10px;position:absolute;top:0;left:0;right:0;z-index:10}
.sv-prog{flex:1;height:2.5px;background:rgba(255,255,255,.25);border-radius:2px;overflow:hidden}
.sv-prog-fill{height:100%;background:#fff;width:0%;border-radius:2px}
.sv-header{position:absolute;top:max(62px,calc(env(safe-area-inset-top)+42px));left:14px;right:14px;display:flex;align-items:center;gap:10px;z-index:10}
.sv-av{width:38px;height:38px;border-radius:13px;object-fit:cover;border:2px solid rgba(255,255,255,.5);cursor:pointer}
.sv-name{font-size:14px;font-weight:700;color:#fff}
.sv-time{font-size:12px;color:rgba(255,255,255,.6)}
.sv-close{margin-left:auto;width:34px;height:34px;display:flex;align-items:center;justify-content:center;cursor:pointer;background:rgba(0,0,0,.3);border-radius:50%}
.sv-img{width:100%;height:100%;object-fit:cover}
.sv-reply{position:absolute;bottom:max(32px,env(safe-area-inset-bottom));left:14px;right:14px;z-index:10;display:flex;align-items:center;gap:10px}
.sv-reply-inp{flex:1;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.3);border-radius:24px;padding:12px 18px;color:#fff;font-family:'Outfit',sans-serif;font-size:14px;outline:none;backdrop-filter:blur(10px)}
.sv-reply-inp::placeholder{color:rgba(255,255,255,.6)}

/* SEARCH */
.search-header{padding:max(18px,env(safe-area-inset-top)) 18px 14px;flex-shrink:0}
.search-title{font-size:26px;font-weight:900;letter-spacing:-1px;margin-bottom:14px}
.search-bar{position:relative}
.search-bar svg{position:absolute;left:14px;top:50%;transform:translateY(-50%);pointer-events:none}
.search-inp{width:100%;background:var(--surface2);border:1px solid var(--border);border-radius:16px;padding:13px 16px 13px 44px;color:var(--text);font-family:'Outfit',sans-serif;font-size:15px;outline:none;transition:border-color .2s,box-shadow .2s}
.search-inp::placeholder{color:var(--text3)}
.search-inp:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-glow)}
.section-label{font-size:12px;font-weight:700;color:var(--text2);letter-spacing:1px;text-transform:uppercase;padding:16px 18px 8px}
.user-row{display:flex;align-items:center;padding:12px 18px;gap:12px;cursor:pointer;transition:background .15s}
.user-row:active{background:var(--surface)}
.u-av{width:52px;height:52px;border-radius:19px;object-fit:cover;border:1.5px solid var(--border2);flex-shrink:0}
.u-info{flex:1;min-width:0}
.u-name{font-size:15px;font-weight:700}
.u-handle{font-size:13px;color:var(--text2)}
.u-followers{font-size:12px;color:var(--text3);margin-top:2px}
.follow-btn{background:var(--accent);border:none;border-radius:12px;padding:9px 18px;color:#fff;font-family:'Outfit',sans-serif;font-size:13px;font-weight:700;cursor:pointer;transition:all .2s;flex-shrink:0}
.follow-btn.following{background:var(--surface2);border:1px solid var(--border2);color:var(--text2)}
.follow-btn:active{transform:scale(.93)}
.explore-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2px}
.explore-cell{aspect-ratio:1;overflow:hidden;cursor:pointer}
.explore-cell img{width:100%;height:100%;object-fit:cover;transition:transform .3s}
.explore-cell:active img{transform:scale(1.08)}

/* MESSAGES */
.msg-header{padding:max(18px,env(safe-area-inset-top)) 18px 10px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
.msg-title{font-size:26px;font-weight:900;letter-spacing:-1px}
.msg-search-wrap{padding:0 18px 10px;flex-shrink:0}
.msg-search-inp{width:100%;background:var(--surface2);border:1px solid var(--border);border-radius:14px;padding:11px 16px 11px 40px;color:var(--text);font-family:'Outfit',sans-serif;font-size:14px;outline:none}
.msg-search-inp::placeholder{color:var(--text3)}
.msg-search-rel{position:relative}
.msg-search-rel svg{position:absolute;left:12px;top:50%;transform:translateY(-50%);pointer-events:none}
.msg-tabs{display:flex;border-bottom:1px solid var(--border);flex-shrink:0;padding:0 18px}
.msg-tab{flex:1;padding:11px 6px;text-align:center;font-size:13px;font-weight:700;color:var(--text2);cursor:pointer;border-bottom:2.5px solid transparent;transition:all .2s}
.msg-tab.active{color:var(--accent-light);border-bottom-color:var(--accent)}
.conv{display:flex;align-items:center;padding:13px 18px;gap:13px;cursor:pointer;transition:background .15s;position:relative}
.conv:active{background:var(--surface)}
.conv-av-wrap{position:relative;flex-shrink:0}
.conv-av{width:54px;height:54px;border-radius:19px;object-fit:cover;border:1.5px solid var(--border2)}
.conv-grp-av{width:54px;height:54px;border-radius:19px;background:linear-gradient(135deg,var(--accent),var(--accent2));display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:800;color:#fff;flex-shrink:0}
.online-dot{width:13px;height:13px;background:var(--green);border-radius:50%;border:2.5px solid var(--bg);position:absolute;bottom:0;right:0}
.conv-info{flex:1;min-width:0}
.conv-name{font-size:15px;font-weight:700;display:flex;align-items:center;gap:5px}
.conv-preview{font-size:13px;color:var(--text2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:3px}
.conv-preview.unread{color:var(--text);font-weight:600}
.conv-right{display:flex;flex-direction:column;align-items:flex-end;gap:5px;flex-shrink:0}
.conv-time{font-size:12px;color:var(--text3)}
.unread-badge{width:20px;height:20px;background:var(--accent);border-radius:50%;font-size:11px;font-weight:800;color:#fff;display:flex;align-items:center;justify-content:center}
.conv-opt-btn{width:28px;height:28px;display:flex;align-items:center;justify-content:center;border-radius:50%;transition:background .15s;cursor:pointer;flex-shrink:0;color:var(--text3)}
.conv-opt-btn:active{background:var(--surface3)}

/* CHAT */
#screen-chat{background:var(--bg)}
.chat-header{display:flex;align-items:center;padding:max(14px,env(safe-area-inset-top)) 14px 12px;gap:12px;border-bottom:1px solid var(--border);flex-shrink:0}
.chat-av{width:42px;height:42px;border-radius:15px;object-fit:cover;border:2px solid var(--accent);cursor:pointer;flex-shrink:0}
.chat-grp-av{width:42px;height:42px;border-radius:15px;background:linear-gradient(135deg,var(--accent),var(--accent2));display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:800;color:#fff;flex-shrink:0;cursor:pointer}
.chat-meta{flex:1;min-width:0;cursor:pointer}
.chat-name-h{font-size:16px;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.chat-status{font-size:12px;font-weight:500}
.chat-msgs{flex:1;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:10px;scrollbar-width:none}
.chat-msgs::-webkit-scrollbar{display:none}
.chat-date{text-align:center;font-size:12px;color:var(--text3);font-weight:600;padding:4px 0 6px}
.bubble-row{display:flex;flex-direction:column;max-width:76%}
.bubble-row.sent{align-self:flex-end;align-items:flex-end}
.bubble-row.recv{align-self:flex-start;align-items:flex-start}
.bubble-row.grp-recv{max-width:82%}
.grp-sender-info{display:flex;align-items:center;gap:7px;margin-bottom:4px;cursor:pointer}
.grp-sender-av{width:26px;height:26px;border-radius:9px;object-fit:cover;flex-shrink:0}
.grp-sender-name{font-size:12px;color:var(--text2);font-weight:600}
.bubble{padding:11px 16px;border-radius:20px;font-size:15px;line-height:1.42;word-break:break-word}
.bubble-row.sent .bubble{background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;border-bottom-right-radius:5px}
.bubble-row.recv .bubble,.bubble-row.grp-recv .bubble{background:var(--surface2);color:var(--text);border-bottom-left-radius:5px}
.bubble-time{font-size:11px;color:var(--text3);padding:3px 4px 0}
.voice-bubble{display:flex;align-items:center;gap:10px;padding:11px 14px;border-radius:20px;min-width:170px;cursor:pointer}
.bubble-row.sent .voice-bubble{background:linear-gradient(135deg,var(--accent),var(--accent2));border-bottom-right-radius:5px}
.bubble-row.recv .voice-bubble,.bubble-row.grp-recv .voice-bubble{background:var(--surface2);border-bottom-left-radius:5px}
.vplay{width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.vwave{flex:1;height:30px;display:flex;align-items:center;gap:2px}
.vbar{border-radius:2px;background:rgba(255,255,255,.45);width:3px}
@keyframes wv{0%,100%{height:3px}50%{height:22px}}
.vdur{font-size:12px;color:rgba(255,255,255,.7);font-weight:600}
.msg-status{font-size:11px;font-weight:600;color:var(--text3);margin-top:2px}
.msg-status.seen{color:var(--accent-light)}
.chat-input-row{display:flex;align-items:center;gap:10px;padding:10px 14px max(10px,env(safe-area-inset-bottom));border-top:1px solid var(--border);flex-shrink:0;background:rgba(8,8,13,.85);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);position:relative;z-index:10}
.c-input-wrapper{flex:1;display:flex;align-items:center;background:var(--surface2);border:1.5px solid var(--border);border-radius:26px;padding:4px;transition:all .25s ease}
.c-input-wrapper:focus-within{border-color:var(--accent);background:rgba(124,58,237,.05);box-shadow:0 0 0 3px var(--accent-glow)}
.rec-bar{display:none;align-items:center;gap:12px;padding:12px 14px;background:rgba(239,68,68,.08);border-top:1px solid rgba(239,68,68,.15);flex-shrink:0}
.rec-bar.on{display:flex}
.rec-dot{width:10px;height:10px;background:#EF4444;border-radius:50%;animation:rp 1s ease-in-out infinite}
@keyframes rp{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.35;transform:scale(.75)}}
.rec-txt{font-size:14px;color:#EF4444;font-weight:600;flex:1}
.rec-timer{font-size:14px;color:#EF4444;font-weight:700;font-variant-numeric:tabular-nums}
.rec-cancel{font-size:14px;color:var(--text2);cursor:pointer;padding:4px 8px}
.c-inp{flex:1;background:transparent;border:none;padding:8px 10px;color:var(--text);font-family:'Outfit',sans-serif;font-size:15px;outline:none;min-width:0}
.c-inp::placeholder{color:var(--text3)}
.c-act{width:36px;height:36px;border-radius:18px;background:transparent;border:none;display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;transition:all .15s;color:var(--text2)}
.c-act:active{transform:scale(.85);background:var(--surface3);color:var(--text)}
