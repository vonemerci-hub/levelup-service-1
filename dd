.sett-row-label{font-size:15px;font-weight:700}
.sett-row-sub{font-size:12px;color:var(--text2);margin-top:2px}
.sett-toggle{position:relative;width:48px;height:27px;flex-shrink:0}
.sett-toggle input{opacity:0;width:0;height:0;position:absolute}
.sett-track{position:absolute;inset:0;background:var(--surface3);border-radius:14px;cursor:pointer;transition:background .25s}
.sett-toggle input:checked+.sett-track{background:var(--accent)}
.sett-thumb{position:absolute;top:3px;left:3px;width:21px;height:21px;background:#fff;border-radius:50%;box-shadow:0 2px 6px rgba(0,0,0,.3);transition:transform .25s;pointer-events:none}
.sett-toggle input:checked~.sett-thumb{transform:translateX(21px)}
.sett-chevron{color:var(--text3);flex-shrink:0}

/* DIALOGS */
.dialog-overlay{position:absolute;inset:0;background:rgba(0,0,0,.7);backdrop-filter:blur(12px);z-index:800;display:none;align-items:center;justify-content:center;padding:24px}
.dialog-overlay.open{display:flex}
.dialog-box{background:var(--bg2);border:1px solid var(--border2);border-radius:24px;width:100%;max-width:340px;overflow:hidden;animation:fadeIn .22s ease}
.dialog-title{font-size:16px;font-weight:800;text-align:center;padding:22px 22px 16px;border-bottom:1px solid var(--border)}
.dialog-option{padding:16px 22px;font-size:15px;font-weight:600;cursor:pointer;border-bottom:1px solid var(--border);transition:background .15s;text-align:center}
.dialog-option:last-child{border-bottom:none}
.dialog-option:active{background:var(--surface2)}
.dialog-option.muted{color:var(--text2)}
.nick-dialog{background:var(--bg2);border:1px solid var(--border2);border-radius:24px;width:100%;max-width:340px;padding:24px 22px;animation:fadeIn .22s ease}
.nick-dialog-title{font-size:16px;font-weight:800;margin-bottom:6px;text-align:center}
.nick-dialog-sub{font-size:13px;color:var(--text2);text-align:center;margin-bottom:16px}
.nick-inp{width:100%;background:var(--surface2);border:1.5px solid var(--border2);border-radius:14px;padding:13px 16px;color:var(--text);font-family:'Outfit',sans-serif;font-size:15px;outline:none;margin-bottom:14px;transition:border-color .2s}
.nick-inp:focus{border-color:var(--accent)}
.nick-btns{display:flex;gap:10px}
.nick-btn{flex:1;padding:12px;border-radius:13px;font-family:'Outfit',sans-serif;font-size:14px;font-weight:700;cursor:pointer;transition:all .15s;border:none}
.nick-btn.cancel{background:var(--surface2);color:var(--text2)}
.nick-btn.confirm{background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff}
.nick-btn:active{transform:scale(.96)}

/* LOGOUT */
.logout-overlay{position:absolute;inset:0;background:rgba(0,0,0,.7);backdrop-filter:blur(12px);z-index:900;display:none;align-items:center;justify-content:center;padding:24px}
.logout-overlay.open{display:flex;animation:fadeIn .2s ease}
.logout-box{background:var(--bg2);border:1px solid var(--border2);border-radius:24px;width:100%;max-width:340px;overflow:hidden;animation:fadeIn .24s ease}
.logout-icon-wrap{width:60px;height:60px;border-radius:20px;background:rgba(239,68,68,.1);display:flex;align-items:center;justify-content:center;margin:28px auto 16px}
.logout-title{font-size:20px;font-weight:900;text-align:center;padding:0 24px 8px}
.logout-sub{font-size:14px;color:var(--text2);text-align:center;padding:0 24px 24px;line-height:1.5}
.logout-btns{display:flex;border-top:1px solid var(--border)}
.logout-btn{flex:1;padding:16px;font-family:'Outfit',sans-serif;font-size:15px;font-weight:700;cursor:pointer;border:none;background:transparent;transition:background .15s}
.logout-btn:active{background:var(--surface2)}
.logout-btn.cancel{color:var(--text2);border-right:1px solid var(--border)}
.logout-btn.confirm{color:var(--red)}

/* ONBOARDING */
.ob-overlay{position:absolute;inset:0;background:rgba(0,0,0,.85);backdrop-filter:blur(16px);z-index:1000;display:none;align-items:center;justify-content:center;padding:20px}
.ob-overlay.open{display:flex}
.ob-box{background:var(--bg2);border:1px solid var(--border2);border-radius:28px;width:100%;max-width:400px;padding:36px 24px;position:relative;overflow:hidden;box-shadow:0 40px 80px rgba(0,0,0,.6);text-align:center}
.ob-progress{position:absolute;top:0;left:0;right:0;height:4px;background:var(--surface3)}
.ob-prog-fill{height:100%;background:linear-gradient(90deg,var(--accent),var(--accent2));width:0%;transition:width .3s ease}
.ob-step{display:flex;flex-direction:column;gap:18px}
.ob-step.hidden{display:none}
.ob-av{width:86px;height:86px;border-radius:28px;object-fit:cover;margin:0 auto;border:3px solid var(--accent);box-shadow:0 0 0 1px var(--accent-glow),0 8px 24px rgba(124,58,237,.35)}
.ob-step-count{font-size:11px;font-weight:800;color:var(--text3);letter-spacing:2px;text-transform:uppercase;margin-bottom:-10px}
.ob-title{font-size:24px;font-weight:900;letter-spacing:-.5px}
.ob-sub{font-size:14px;color:var(--text2);line-height:1.4}
.ob-inp{text-align:center;font-size:18px;padding:18px;border-radius:18px;background:var(--surface2);border:1.5px solid var(--border);color:var(--text);font-family:'Outfit',sans-serif;outline:none;width:100%}
.ob-inp:focus{border-color:var(--accent)}
.ob-btns{display:flex;flex-direction:column;gap:12px;margin-top:12px}
.ob-back{align-self:flex-start;font-size:13px;color:var(--text2);cursor:pointer;font-weight:600;display:flex;align-items:center;gap:6px;margin-bottom:-10px}
.ob-upload-zone{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;border:2px dashed var(--border2);border-radius:20px;padding:28px 20px;background:var(--surface);cursor:pointer;transition:all .2s}
.ob-upload-zone:active{border-color:var(--accent);background:rgba(124,58,237,.08)}

/* TOAST */
.toast-wrap{position:absolute;top:18px;left:0;right:0;z-index:9999;pointer-events:none;display:flex;justify-content:center;padding-top:env(safe-area-inset-top)}
.toast{background:rgba(20,20,35,.95);border:1px solid var(--border2);backdrop-filter:blur(32px);border-radius:16px;padding:13px 20px;font-size:14px;font-weight:600;color:var(--text);transform:translateY(-80px);opacity:0;transition:all .32s cubic-bezier(.16,1,.3,1);max-width:300px;text-align:center}
.toast.show{transform:translateY(0);opacity:1}

/* POWERED */
.powered-footer{display:flex;flex-direction:column;align-items:center;gap:6px;padding:24px 20px max(24px,env(safe-area-inset-bottom))}
.powered-badge{display:flex;align-items:center;gap:7px}
.powered-text{font-size:11px;font-weight:700;letter-spacing:.5px;color:var(--text2)}
.powered-brand{font-size:11px;font-weight:900;letter-spacing:.5px;background:linear-gradient(135deg,var(--accent),var(--accent2));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.powered-links{display:flex;gap:18px}
.powered-link{font-size:11px;color:var(--text3);text-decoration:none;font-weight:500}
.powered-link:active{color:var(--accent-light)}

/* MISC */
input[type="file"]{display:none}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
@keyframes sUp{from{transform:translateY(100%)}to{transform:translateY(0)}}
.fade-in{animation:fadeIn .3s ease both}

@media(min-width:600px){
.post-overlay,.comments-overlay,.conv-opt-overlay,.grp-overlay,.uprofile-overlay{align-items:center}
.post-sheet,.comments-sheet,.conv-opt-sheet,.grp-sheet,.uprofile-sheet,.share-sheet{border-radius:28px;border-bottom:1px solid var(--border2);max-height:85vh}
.comments-sheet{height:600px}
}
@media(min-width:768px){
#screen-auth{flex-direction:row}
.auth-hero{flex:1;background:url('https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=2000&auto=format&fit=crop') center/cover no-repeat;position:relative}
.auth-hero::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(8,8,13,.9),rgba(124,58,237,.3));backdrop-filter:blur(8px)}
.auth-hero>div{position:relative;z-index:10;transform:translateY(-30px)}
.auth-logo-text{font-size:140px}
.auth-tagline{font-size:16px;letter-spacing:4px;color:rgba(255,255,255,.8)}
.auth-form-container{width:560px;max-width:560px;background:var(--bg);border-left:1px solid var(--border);padding:0 50px}
.auth-card{box-shadow:none;border:none;background:transparent;padding:0;backdrop-filter:none}
}
</style>
</head>
