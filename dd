function onToggle(key,val){}
function cycleOnlineStatus(){ const opts=['Everyone can see','Friends only','Nobody']; const el=document.getElementById('sett-online-val'); const i=opts.indexOf(el.textContent); el.textContent=opts[(i+1)%opts.length]; }
function cycleLastSeen(){ const opts=['Shown to everyone','Friends only','Hidden']; const el=document.getElementById('sett-lastseen-val'); const i=opts.indexOf(el.textContent); el.textContent=opts[(i+1)%opts.length]; }
function cycleStoryPrivacy(){ const opts=['Everyone','Friends','Only me']; const el=document.getElementById('sett-story-priv'); const i=opts.indexOf(el.textContent); el.textContent=opts[(i+1)%opts.length]; }

var toastTimer=null;
function showToast(msg){
if(!msg.includes('⚠️')) return; // Silences all non-error loading/action toasts
const t=document.getElementById('toast'); t.textContent=msg; t.classList.add('show');
clearTimeout(toastTimer); toastTimer=setTimeout(()=>t.classList.remove('show'),2400);
}

