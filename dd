/* Generic Settings Modal Logic */
function openSettModal(action, title, desc, inputPlaceholder, btnText, isDanger) {
    currentSettAction = action;
    document.getElementById('sett-modal-title').textContent = title;
    document.getElementById('sett-modal-desc').textContent = desc;
    
    const inp = document.getElementById('sett-modal-inp');
