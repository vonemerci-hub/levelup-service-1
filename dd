        inp.placeholder = inputPlaceholder;
        inp.value = '';
    } else {
        inp.style.display = 'none';
    }
    
    const btn = document.getElementById('sett-modal-btn');
    btn.textContent = btnText;
    btn.style.background = isDanger ? 'var(--red)' : 'linear-gradient(135deg,var(--accent),var(--accent2))';
    
    document.getElementById('sett-modal-overlay').classList.add('open');
    if(inputPlaceholder) setTimeout(() => inp.focus(), 100);
}

function confirmSettModal() {
    const val = document.getElementById('sett-modal-inp').value.trim();
    if(currentSettAction === 'delete') {
        if(val !== 'DELETE') {
            showToast('⚠️ Type DELETE to confirm');
            return;
        } else {
            document.getElementById('sett-modal-overlay').classList.remove('open');
            setTimeout(() => doLogout(), 300);
            return;
        }
    }
    
    document.getElementById('sett-modal-overlay').classList.remove('open');
    if(currentSettAction === 'email' && val) {
        document.getElementById('sett-email').textContent = val;
    }
}

