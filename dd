const hasImg=document.getElementById('post-img-preview').style.display!=='none';
if(currentPostType==='story'){ if(!hasImg){ showToast('⚠️ Story needs a photo!'); return; } STORIES.unshift({uid:'me',img:document.getElementById('post-preview-img').src,time:'now',seen:false}); incDaily('story'); closePost(); renderFeed(); updateDailyPills(); return; }
if(currentPostType==='moment'&&!hasImg){ showToast('⚠️ Moment needs a photo!'); return; }
