function openChat(uid){
const usr=u(uid); if(!usr) return;
isGroupChat=false; chatUID=uid; chatGID=null;
const conv=CONVS.find(c=>c.uid===uid); if(conv) conv.unread=0;
document.getElementById('chat-av-slot').innerHTML=`<img class="chat-av" src="${usr.av}" alt="">`;
document.getElementById('chat-name-h').textContent=conv?.nickname||usr.name;
document.getElementById('chat-status').textContent=usr.online?'● Online now':'Last seen recently';
document.getElementById('chat-status').style.color=usr.online?'var(--green)':'var(--text3)';
renderMessages(uid); goTo('chat');
setTimeout(()=>{ const m=document.getElementById('chat-msgs'); m.scrollTop=m.scrollHeight; },100);
}
function openGroupChat(gid){
const grp=GROUPS.find(g=>g.id===gid); if(!grp) return;
isGroupChat=true; chatGID=gid; chatUID=null;
grp.unread=0;
const initials=grp.name.replace(/[^\w\s]/g,'').trim().split(' ').map(w=>w[0]).join('').slice(0,2).toUpperCase()||'GP';
document.getElementById('chat-av-slot').innerHTML=`<div class="chat-grp-av">${initials}</div>`;
document.getElementById('chat-name-h').textContent=grp.name;
document.getElementById('chat-status').textContent=`${grp.memberIds.length+1} members`;
document.getElementById('chat-status').style.color='var(--text2)';
renderGroupMessages(gid); goTo('chat');
setTimeout(()=>{ const m=document.getElementById('chat-msgs'); m.scrollTop=m.scrollHeight; },100);
}
function renderMessages(uid){
const conv=CONVS.find(c=>c.uid===uid);
const readOn=document.getElementById('tog-read')?.checked!==false;
document.getElementById('chat-msgs').innerHTML=`<div class="chat-date">Today</div>`+(conv?.msgs||[]).map(m=>{
const dir=m.r?'recv':'sent';
const statusHTML=(!m.r&&readOn)?`<div class="msg-status${m.seen?' seen':''}">${m.seen?'Seen':'Sent'}</div>`:'';
if(m.v){
const bars=Array.from({length:20},(_,i)=>{const h=4+Math.round(Math.sin(i*.7+1)*10+Math.random()*8);return`<div class="vbar" style="height:${h}px"></div>`;}).join('');
return `<div class="bubble-row ${dir}"><div class="voice-bubble"><div class="vplay"><svg width="14" height="14" fill="white" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"/></svg></div><div class="vwave">${bars}</div><div class="vdur">${m.dur}</div></div><div style="display:flex;gap:4px;align-items:center"><div class="bubble-time">${m.time}</div>${statusHTML}</div></div>`;
}
return `<div class="bubble-row ${dir}"><div class="bubble">${m.t}</div><div style="display:flex;gap:4px;align-items:center"><div class="bubble-time">${m.time}</div>${statusHTML}</div></div>`;
}).join('');
}
function renderGroupMessages(gid){
const grp=GROUPS.find(g=>g.id===gid); if(!grp) return;
document.getElementById('chat-msgs').innerHTML=`<div class="chat-date">Today</div>`+grp.msgs.map(m=>{
if(m.uid==='me'||m.isMe) return `<div class="bubble-row sent"><div class="bubble">${m.t}</div><div class="bubble-time">${m.time}</div></div>`;
const sender=u(m.uid);
return `<div class="bubble-row recv grp-recv">
<div class="grp-sender-info" onclick="openUserProfile(${m.uid})">
<img class="grp-sender-av" src="${sender?.av||''}" alt="">
<span class="grp-sender-name">${sender?.name||'Unknown'}</span>
</div>
<div class="bubble">${m.t}</div>
<div class="bubble-time">${m.time}</div>
</div>`;
}).join('');
}
function sendMsg(){
if(isGroupChat){ sendGroupMsg(); return; }
const inp=document.getElementById('chat-inp'); const text=inp.value.trim(); if(!text) return;
const conv=CONVS.find(c=>c.uid===chatUID); if(!conv) return;
const now=new Date(); const time=now.getHours()+':'+String(now.getMinutes()).padStart(2,'0');
conv.msgs.push({r:false,t:text,time,seen:false}); inp.value='';
renderMessages(chatUID);
const msgsEl=document.getElementById('chat-msgs'); setTimeout(()=>msgsEl.scrollTop=msgsEl.scrollHeight,50);
const typingOn=document.getElementById('tog-typing')?.checked!==false;
const delay=900+Math.random()*1200;
const replies=['❤️','Haha yes!!','That is so true 😂','Love this!','🙌🙌','For real!','Wait what 😭','No way lmao','🔥🔥','OK but wow','Omg stop 😭','Facts frr'];
if(typingOn){
setTimeout(()=>{
showTyping();
setTimeout(()=>{
hideTyping();
conv.msgs.push({r:true,t:replies[Math.floor(Math.random()*replies.length)],time});
const sent=[...conv.msgs].reverse().find(m=>!m.r&&!m.v); if(sent) sent.seen=true;
renderMessages(chatUID); setTimeout(()=>msgsEl.scrollTop=msgsEl.scrollHeight,50);
},1200+Math.random()*1400);
},delay);
} else {
setTimeout(()=>{
conv.msgs.push({r:true,t:replies[Math.floor(Math.random()*replies.length)],time});
const sent=[...conv.msgs].reverse().find(m=>!m.r&&!m.v); if(sent) sent.seen=true;
renderMessages(chatUID); setTimeout(()=>msgsEl.scrollTop=msgsEl.scrollHeight,50);
},delay);
}
}
function sendGroupMsg(){
const inp=document.getElementById('chat-inp'); const text=inp.value.trim(); if(!text) return;
const grp=GROUPS.find(g=>g.id===chatGID); if(!grp) return;
const now=new Date(); const time=now.getHours()+':'+String(now.getMinutes()).padStart(2,'0');
grp.msgs.push({uid:'me',t:text,time}); inp.value='';
renderGroupMessages(chatGID);
const msgsEl=document.getElementById('chat-msgs'); setTimeout(()=>msgsEl.scrollTop=msgsEl.scrollHeight,50);
setTimeout(()=>{
const rid=grp.memberIds[Math.floor(Math.random()*grp.memberIds.length)];
const reps=['🔥','OK!','Yes!','Haha 😂','Let\'s go!','I agree','Makes sense','Nice!','Facts','For real'];
grp.msgs.push({uid:rid,t:reps[Math.floor(Math.random()*reps.length)],time});
renderGroupMessages(chatGID); setTimeout(()=>msgsEl.scrollTop=msgsEl.scrollHeight,50);
},1500+Math.random()*1500);
}
function showTyping(){
const usr=u(chatUID); if(!usr||document.getElementById('typing-row')) return;
const msgsEl=document.getElementById('chat-msgs');
const div=document.createElement('div'); div.id='typing-row'; div.className='typing-row fade-in';
div.innerHTML=`<img style="width:26px;height:26px;border-radius:9px;object-fit:cover" src="${usr.av}" alt=""><div><div class="typing-bubble"><div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div></div><div style="font-size:11px;color:var(--text3);padding:3px 4px">${usr.name} is typing…</div></div>`;
msgsEl.appendChild(div); msgsEl.scrollTop=msgsEl.scrollHeight;
}
function hideTyping(){ document.getElementById('typing-row')?.remove(); }
function openChatInfo(){
if(isGroupChat) openGroupInfo(chatGID);
else openUserProfile(chatUID);
}
function openChatConvOpt(){
if(isGroupChat) openConvOpt(null,true,chatGID);
else openConvOpt(chatUID,false);
}

/* ═══════════════════════════════════════
VOICE RECORDING
═══════════════════════════════════════ */
function toggleRec(){ isRecording?stopRec(true):startRec(); }
function startRec(){
isRecording=true; recSecs=0;
document.getElementById('rec-bar').classList.add('on');
document.getElementById('mic-btn').style.color='var(--red)';
recInterval=setInterval(()=>{ recSecs++; document.getElementById('rec-timer').textContent=Math.floor(recSecs/60)+':'+String(recSecs%60).padStart(2,'0'); },1000);
}
function stopRec(send=false){
isRecording=false; clearInterval(recInterval);
document.getElementById('rec-bar').classList.remove('on');
document.getElementById('mic-btn').style.color='';
if(send&&recSecs>0){
const dur=Math.floor(recSecs/60)+':'+String(recSecs%60).padStart(2,'0');
const now=new Date(); const time=now.getHours()+':'+String(now.getMinutes()).padStart(2,'0');
if(isGroupChat){ const grp=GROUPS.find(g=>g.id===chatGID); if(grp){ grp.msgs.push({uid:'me',v:true,dur,time}); renderGroupMessages(chatGID); } }
else{ const conv=CONVS.find(c=>c.uid===chatUID); if(conv){ conv.msgs.push({r:false,v:true,dur,time}); renderMessages(chatUID); } }
const m=document.getElementById('chat-msgs'); setTimeout(()=>m.scrollTop=m.scrollHeight,50);
}
recSecs=0;
}
function cancelRec(){ stopRec(false); }

